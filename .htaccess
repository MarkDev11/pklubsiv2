Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Blokir file sensitif
    RewriteRule ^(\.env|\.env\..*|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|pint\.json|phpstan\.neon|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js)$ - [F,L,NC]

    # Blokir direktori sensitif
    RewriteRule ^(\.git|vendor|storage|bootstrap|config|database|resources|routes|tests|node_modules)(/|$) - [F,L,NC]

    # Redirect semua request ke folder /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|pint\.json|phpstan\.neon|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
